---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import site from '~/data/site.json';
import faqData from '~/data/faq.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'pt' && !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug.replace(/^pt\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d: Date) {
  return new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}

// All other PT posts (for related)
const all = (await getCollection('blog', ({ data }) => data.lang === 'pt' && !data.draft))
  .filter(p => p.slug !== post.slug)
  .map(p => ({ ...p, cleanSlug: p.slug.replace(/^pt\//, '') }))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 2);

// Compute word count from rendered markdown for Article schema
const rawBody = post.body || '';
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.coverImage ? new URL(post.data.coverImage, Astro.site).toString() : undefined,
  "datePublished": post.data.publishDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": new URL("/sobre", Astro.site).toString(),
    "jobTitle": "Massagista tailandês",
    "knowsAbout": ["Massagem tailandesa", "Nuad Boran", "Yoga", "Liberação miofascial"],
  },
  "publisher": {
    "@type": "Organization",
    "name": "Vicji Massage",
    "url": Astro.site?.toString(),
    "logo": { "@type": "ImageObject", "url": new URL("/og-image.jpg", Astro.site).toString() },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": new URL(`/blog/${post.slug.replace(/^pt\//, '')}`, Astro.site).toString() },
  "inLanguage": "pt-BR",
  "wordCount": wordCount,
  "articleSection": post.data.tags?.[0] ?? "Massagem tailandesa",
  ...(post.data.keywords?.length ? { "keywords": post.data.keywords.join(", ") } : {}),
};

// FAQPage schema — only emitted when showFAQ is true on the post
const faqPageSchema = post.data.showFAQ ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqData.pt.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
} : null;
---
<BaseLayout
  title={`${post.data.title} · Blog Vicji Massage`}
  description={post.data.description}
  lang="pt"
  path={`/blog/${post.slug.replace(/^pt\//, '')}`}
>
  <article>
    <header class="pt-24 pb-12">
      <div class="container-narrow">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-terracotta transition-colors mb-8">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Voltar para o blog
        </a>
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-muted uppercase tracking-widest2 mb-4">
          <time datetime={post.data.publishDate.toISOString()}>{fmtDate(post.data.publishDate)}</time>
          {post.data.readingTime && <><span>·</span><span>{post.data.readingTime}</span></>}
          <span>·</span><span>Por {post.data.author}</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ocean leading-tight mb-6">
          {post.data.title}
        </h1>
        <p class="text-ink-muted text-xl leading-relaxed">{post.data.description}</p>
      </div>
    </header>

    {post.data.coverImage && (
      <div class="container-wide mb-16">
        <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-ocean-dark max-w-5xl mx-auto">
          <picture>
            <source type="image/webp" srcset={post.data.coverImage.replace(/\.(jpe?g|png)$/i, '.webp')} />
            <img
              src={post.data.coverImage}
              alt={post.data.coverAlt ?? post.data.title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </picture>
        </div>
      </div>
    )}

    <div class="container-narrow pb-16">
      <div class="prose-blog max-w-prose mx-auto">
        <Content />
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-sand-deep/30 max-w-prose mx-auto">
          {post.data.tags.map(t => (
            <span class="text-xs uppercase tracking-widest2 text-terracotta bg-terracotta/10 px-3 py-1.5 rounded-full">{t}</span>
          ))}
        </div>
      )}

      {post.data.showFAQ && (
        <section class="mt-16 pt-12 border-t border-sand-deep/30 max-w-prose mx-auto">
          <h2 class="font-display text-3xl sm:text-4xl text-ocean mb-3 leading-tight">Perguntas frequentes</h2>
          <p class="text-ink-muted mb-8">As dúvidas mais comuns sobre a Thai Massage tradicional.</p>
          <div class="space-y-3">
            {faqData.pt.map(item => (
              <details class="group bg-white/60 backdrop-blur-sm rounded-2xl border border-sand-deep/30 overflow-hidden">
                <summary class="cursor-pointer p-5 sm:p-6 flex items-center justify-between gap-4 list-none">
                  <span class="font-display text-lg sm:text-xl text-ocean pr-4">{item.q}</span>
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sand-dark/40 flex items-center justify-center text-ocean group-open:rotate-45 transition-transform duration-300">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </summary>
                <div class="px-5 sm:px-6 pb-5 sm:pb-6 text-ink-muted leading-relaxed">{item.a}</div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    {all.length > 0 && (
      <section class="py-16 bg-sand-dark/30">
        <div class="container-wide">
          <h2 class="font-display text-3xl text-ocean text-center mb-12">Outros textos</h2>
          <div class="grid sm:grid-cols-2 gap-8 max-w-4xl mx-auto">
            {all.map(p => (
              <a href={`/blog/${p.cleanSlug}`} class="group bg-white/70 rounded-2xl p-6 border border-sand-deep/30 hover:shadow-soft transition-all">
                <h3 class="font-display text-xl text-ocean group-hover:text-terracotta transition-colors mb-2 leading-tight">{p.data.title}</h3>
                <p class="text-ink-muted text-sm leading-relaxed">{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <FinalCTA lang="pt" />

  <Breadcrumbs items={[
    { name: 'Início', href: '/' },
    { name: 'Blog', href: '/blog' },
    { name: post.data.title, href: `/blog/${post.slug.replace(/^pt\//, '')}` },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqPageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  )}
</BaseLayout>
