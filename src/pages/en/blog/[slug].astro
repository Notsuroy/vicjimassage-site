---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import FinalCTA from '~/components/FinalCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map(post => ({ params: { slug: post.slug.replace(/^en\//, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d: Date) {
  return new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}
---
<BaseLayout
  title={`${post.data.title} · Vicji Massage Blog`}
  description={post.data.description}
  lang="en"
  path={`/en/blog/${post.slug.replace(/^en\//, '')}`}
>
  <article>
    <header class="pt-24 pb-12">
      <div class="container-narrow">
        <a href="/en/blog" class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-terracotta transition-colors mb-8">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to the blog
        </a>
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-muted uppercase tracking-widest2 mb-4">
          <time datetime={post.data.publishDate.toISOString()}>{fmtDate(post.data.publishDate)}</time>
          {post.data.readingTime && <><span>·</span><span>{post.data.readingTime}</span></>}
          <span>·</span><span>By {post.data.author}</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ocean leading-tight mb-6">{post.data.title}</h1>
        <p class="text-ink-muted text-xl leading-relaxed">{post.data.description}</p>
      </div>
    </header>
    {post.data.coverImage && (
      <div class="container-wide mb-16">
        <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-ocean-dark max-w-5xl mx-auto">
          <img src={post.data.coverImage} alt={post.data.coverAlt ?? post.data.title} class="w-full h-full object-cover" loading="eager" />
        </div>
      </div>
    )}
    <div class="container-narrow pb-16">
      <div class="prose-blog max-w-prose mx-auto">
        <Content />
      </div>
    </div>
  </article>
  <FinalCTA lang="en" />
</BaseLayout>
