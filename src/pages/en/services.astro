---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicesGrid from '~/components/ServicesGrid.astro';
import CredentialsStrip from '~/components/CredentialsStrip.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import services from '~/data/services.json';
import site from '~/data/site.json';

const offerCatalog = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Traditional Thai Massage",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Vicji Massage",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.location.street,
      "addressLocality": site.location.city,
      "addressRegion": site.location.state,
      "postalCode": site.location.postalCode,
      "addressCountry": "BR",
    },
  },
  "areaServed": { "@type": "City", "name": "Itacaré" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Sessions",
    "itemListElement": services.services.flatMap(s =>
      s.options.map(o => ({
        "@type": "Offer",
        "name": `${s.name.en}, ${o.label.en}`,
        "description": s.description.en,
        "price": o.price,
        "priceCurrency": "BRL",
        "itemOffered": {
          "@type": "Service",
          "name": s.name.en,
          "duration": `PT${o.duration.replace(/[^\d]/g, '')}H`.replace('H30', 'H30M'),
        },
      }))
    ),
  },
};
---
<BaseLayout
  title="Services · Vicji Massage"
  description="Traditional Thai Massage and Hip Release sessions in Itacaré, Bahia, Brazil. Work in three dimensions: physical, energetic, spiritual."
  lang="en"
  path="/en/services"
>
  <section class="pt-24 pb-16">
    <div class="container-narrow text-center">
      <div class="label-overline mb-4">Services</div>
      <h1 class="font-display text-5xl sm:text-6xl text-ocean mb-6 leading-tight">
        Exclusive, original sessions.
      </h1>
      <p class="text-ink-muted text-lg leading-relaxed max-w-2xl mx-auto">
        Traditional Thai Massage runs through the whole body. Hip Release dives into the foundation. Both integrate the physical, energetic, and spiritual work.
      </p>
    </div>
  </section>

  <CredentialsStrip lang="en" />

  <ServicesGrid lang="en" showAll={true} />

  <!-- Duration philosophy -->
  <section class="py-20 sm:py-24">
    <div class="container-narrow">
      <div class="bg-ocean rounded-3xl p-8 sm:p-12 text-sand shadow-soft">
        <div class="label-overline text-gold mb-4">About the time</div>
        <h2 class="font-display text-3xl sm:text-4xl mb-6 leading-tight text-sand">
          Why my sessions last 1h30, 2h, or 3h.
        </h2>
        <div class="space-y-4 text-sand/90 leading-relaxed">
          <p>
            Most massage sessions on the market run 60 minutes. Not because 60 minutes is what the body needs. Because 60 minutes fits the schedule of practitioners selling the session as a product, between one client and the next.
          </p>
          <p>
            Traditional Thai Massage does not work that way. In Thailand, two, three, even four hour sessions are the standard. The work is slow. The body needs time to open and reorganize. The energy lines have to be walked end to end. The stretches have to be held. The integration at the end is part of the practice, it is not an add-on.
          </p>
          <p>
            When you book a 2h or 3h session with me, you are not paying for more time. You are investing for the work to actually happen. No clock rushing it, no shortened technique, no closing before the body has gone where it needs to go.
          </p>
          <p class="font-display italic text-lg text-gold">
            It is the difference between scratching the surface and actually immersing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-sand-dark/30">
    <div class="container-narrow">
      <div class="text-center mb-16">
        <div class="label-overline mb-4">What a session with me looks like</div>
        <h2 class="font-display text-4xl sm:text-5xl text-ocean leading-tight">
          The session has five moments.
        </h2>
      </div>

      <div class="space-y-6">
        {services.sessionStructure.en.map((step, i) => (
          <div class="flex gap-6 bg-white/60 rounded-2xl p-6 sm:p-8 border border-sand-deep/30">
            <div class="flex-shrink-0 text-3xl sm:text-4xl">{step.icon}</div>
            <div class="flex-1">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="text-gold font-display text-sm">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="font-display text-2xl text-ocean">{step.label}</h3>
              </div>
              <p class="text-ink-muted leading-relaxed">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-narrow">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <div class="text-2xl mb-3">🧘</div>
          <h2 class="font-display text-2xl text-ocean mb-4">How to prepare</h2>
          <ul class="space-y-3 text-ink-muted">
            {services.preparation.en.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-terracotta mt-0.5">·</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <div class="text-2xl mb-3">⚠️</div>
          <h2 class="font-display text-2xl text-ocean mb-4">Contraindications</h2>
          <p class="text-ink-muted text-sm mb-4">In any of these cases, let me know in advance so we can decide together:</p>
          <ul class="space-y-2 text-ink-muted text-sm">
            {services.contraindications.en.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-terracotta mt-0.5">·</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="bg-sand-dark/30 rounded-2xl p-8 mt-8">
        <h3 class="font-display text-2xl text-ocean mb-4">Payment and cancellation</h3>
        <ul class="space-y-2 text-ink-muted">
          <li>· Pix, cash, credit or debit card, at the time of the session</li>
          <li>· International clients: cash or international card</li>
          <li>· Cancellations with at least 24h notice, no charge. After that, a fee of R$ 200 applies, out of respect for the time reserved exclusively for your session.</li>
        </ul>
      </div>
    </div>
  </section>

  <FAQ lang="en" />
  <FinalCTA lang="en" />

  <Breadcrumbs items={[
    { name: 'Home', href: '/en/' },
    { name: 'Services', href: '/en/services' },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(offerCatalog)} />
</BaseLayout>
