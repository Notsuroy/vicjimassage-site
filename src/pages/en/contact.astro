---
import BaseLayout from '~/layouts/BaseLayout.astro';
import site from '~/data/site.json';
const mapsUrl = `https://www.google.com/maps?q=${encodeURIComponent(site.location.mapsQuery)}`;
---
<BaseLayout
  title="Contact · Vicji Massage"
  description="How to reach Vicji. Studio at Espaço Clô, Atibaia, Brazil."
  lang="en"
  path="/en/contact"
>
  <section class="py-24 sm:py-32">
    <div class="container-narrow">
      <div class="label-overline mb-4">Contact</div>
      <h1 class="font-display text-5xl sm:text-6xl text-ocean mb-12 leading-tight">
        Where to find me.
      </h1>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <h2 class="font-display text-2xl text-ocean mb-4">Studio</h2>
          <address class="not-italic text-ink-muted leading-relaxed">
            <strong class="text-ink">{site.location.studio}</strong><br />
            {site.location.street}<br />
            {site.location.neighborhood}<br />
            {site.location.city}, {site.location.state}<br />
            {site.location.postalCode}, {site.location.countryEn}
          </address>
          <a href={mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 text-ocean hover:text-terracotta transition-colors text-sm">
            Open in Google Maps
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
          </a>
        </div>

        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <h2 class="font-display text-2xl text-ocean mb-4">Direct</h2>
          <ul class="space-y-3 text-ink-muted">
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">WhatsApp</span>
              <a href="/en/book" class="text-ink hover:text-ocean">Message me →</a>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">Instagram</span>
              <a href={site.contact.instagramUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-ink hover:text-ocean transition-colors group">
                <svg width="18" height="18" viewBox="0 0 24 24">
                  <defs>
                    <linearGradient id="ig-grad-contact-en" x1="0%" y1="100%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#FED576" />
                      <stop offset="25%" stop-color="#F47133" />
                      <stop offset="50%" stop-color="#BC3081" />
                      <stop offset="75%" stop-color="#4C63D2" />
                      <stop offset="100%" stop-color="#5851DB" />
                    </linearGradient>
                  </defs>
                  <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#ig-grad-contact-en)" />
                  <rect x="4.5" y="4.5" width="15" height="15" rx="4" fill="none" stroke="white" stroke-width="1.5" />
                  <circle cx="12" cy="12" r="3.5" fill="none" stroke="white" stroke-width="1.5" />
                  <circle cx="17.5" cy="6.5" r="0.9" fill="white" />
                </svg>
                @{site.contact.instagram} · {site.contact.instagramFollowers} followers
              </a>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">Hours</span>
              <span class="text-ink">{site.hours.en}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 aspect-[16/9] rounded-2xl overflow-hidden border border-sand-deep/30 bg-sand-dark/30 flex items-center justify-center">
        <iframe
          src={`https://www.google.com/maps?q=${encodeURIComponent(site.location.mapsQuery)}&output=embed`}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="mt-12 bg-sand-dark/30 rounded-2xl p-8 text-center">
        <div class="label-overline mb-2">Coming soon</div>
        <p class="font-display text-2xl text-ocean">Itacaré, Bahia</p>
        <p class="text-ink-muted mt-2">
          {site.location.futureLocation.note.en}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
