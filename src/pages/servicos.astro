---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicesGrid from '~/components/ServicesGrid.astro';
import CredentialsStrip from '~/components/CredentialsStrip.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import services from '~/data/services.json';
import site from '~/data/site.json';

const offerCatalog = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Massagem Tailandesa Tradicional",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Vicji Massage",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.location.street,
      "addressLocality": site.location.city,
      "addressRegion": site.location.state,
      "postalCode": site.location.postalCode,
      "addressCountry": "BR",
    },
    "telephone": site.contact.whatsapp.startsWith('TODO') ? undefined : `+${site.contact.whatsapp}`,
  },
  "areaServed": { "@type": "City", "name": "Atibaia" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Sessões",
    "itemListElement": services.services.flatMap(s =>
      s.options.map(o => ({
        "@type": "Offer",
        "name": `${s.name.pt}, ${o.label.pt}`,
        "description": s.description.pt,
        "price": o.price,
        "priceCurrency": "BRL",
        "itemOffered": {
          "@type": "Service",
          "name": s.name.pt,
          "duration": `PT${o.duration.replace(/[^\d]/g, '')}H`.replace('H30', 'H30M'),
        },
      }))
    ),
  },
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": Astro.site?.toString() },
    { "@type": "ListItem", "position": 2, "name": "Serviços", "item": new URL("/servicos", Astro.site).toString() },
  ],
};
---
<BaseLayout
  title="Serviços · Vicji Massage"
  description="Sessões de Thai Massage tradicional e Liberação de Quadril em Atibaia. Trabalho em três níveis: físico, energético e espiritual."
  lang="pt"
  path="/servicos"
>
  <section class="pt-24 pb-16">
    <div class="container-narrow text-center">
      <div class="label-overline mb-4">Serviços</div>
      <h1 class="font-display text-5xl sm:text-6xl text-ocean mb-6 leading-tight">
        Sessões exclusivas e originais.
      </h1>
      <p class="text-ink-muted text-lg leading-relaxed max-w-2xl mx-auto">
        A Thai Massage Tradicional percorre o corpo inteiro. A Liberação de Quadril mergulha na base. Ambas integram o trabalho físico, energético e espiritual.
      </p>
    </div>
  </section>

  <CredentialsStrip lang="pt" />

  <ServicesGrid lang="pt" showAll={true} />

  <!-- Duration philosophy -->
  <section class="py-20 sm:py-24">
    <div class="container-narrow">
      <div class="bg-ocean rounded-3xl p-8 sm:p-12 text-sand shadow-soft">
        <div class="label-overline text-gold mb-4">Sobre o tempo</div>
        <h2 class="font-display text-3xl sm:text-4xl mb-6 leading-tight text-sand">
          Por que minhas sessões duram 1h30, 2h ou 3h.
        </h2>
        <div class="space-y-4 text-sand/90 leading-relaxed">
          <p>
            A grande maioria das massagens no Brasil dura uma hora. Não é porque uma hora é o tempo que o corpo precisa. É porque uma hora cabe na agenda de quem vende a sessão como um produto, entre um cliente e outro.
          </p>
          <p>
            A Thai Massage tradicional não funciona assim. Na Tailândia, sessões de duas, três e até quatro horas são o padrão. O trabalho é lento. O corpo precisa de tempo para se abrir e reorganizar. As linhas de energia precisam ser percorridas inteiras. Os alongamentos precisam ser sustentados. A integração no final é parte da prática, não é um extra.
          </p>
          <p>
            Quando você fecha uma sessão de 2h ou 3h comigo, você não está pagando por mais tempo. Está investindo para que o trabalho aconteça de verdade. Sem cronômetro acelerando, sem manobras encurtadas, sem encerrar antes do corpo ter ido onde precisa ir.
          </p>
          <p class="font-display italic text-lg text-gold">
            É a diferença entre arranhar a superfície e realmente imergir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Session structure -->
  <section class="py-24 bg-sand-dark/30">
    <div class="container-narrow">
      <div class="text-center mb-16">
        <div class="label-overline mb-4">Como é uma sessão comigo</div>
        <h2 class="font-display text-4xl sm:text-5xl text-ocean leading-tight">
          A sessão tem cinco momentos.
        </h2>
      </div>

      <div class="space-y-6">
        {services.sessionStructure.pt.map((step, i) => (
          <div class="flex gap-6 bg-white/60 rounded-2xl p-6 sm:p-8 border border-sand-deep/30">
            <div class="flex-shrink-0 text-3xl sm:text-4xl">{step.icon}</div>
            <div class="flex-1">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="text-gold font-display text-sm">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="font-display text-2xl text-ocean">{step.label}</h3>
              </div>
              <p class="text-ink-muted leading-relaxed">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Preparation + Contraindications -->
  <section class="py-24">
    <div class="container-narrow">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <div class="text-2xl mb-3">🧘</div>
          <h2 class="font-display text-2xl text-ocean mb-4">Como se preparar</h2>
          <ul class="space-y-3 text-ink-muted">
            {services.preparation.pt.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-terracotta mt-0.5">·</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <div class="text-2xl mb-3">⚠️</div>
          <h2 class="font-display text-2xl text-ocean mb-4">Contraindicações</h2>
          <p class="text-ink-muted text-sm mb-4">Em qualquer um desses casos, me avisa antes para decidirmos juntos:</p>
          <ul class="space-y-2 text-ink-muted text-sm">
            {services.contraindications.pt.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-terracotta mt-0.5">·</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="bg-sand-dark/30 rounded-2xl p-8 mt-8">
        <h3 class="font-display text-2xl text-ocean mb-4">Pagamento e cancelamento</h3>
        <ul class="space-y-2 text-ink-muted">
          <li>· Pix, dinheiro, cartão de crédito ou débito, na hora da sessão</li>
          <li>· Cancelamentos com até 24h de antecedência, sem custo</li>
          <li>· Clientes internacionais: dinheiro ou cartão internacional</li>
        </ul>
      </div>
    </div>
  </section>

  <FAQ lang="pt" />
  <FinalCTA lang="pt" />

  <Breadcrumbs items={[
    { name: 'Início', href: '/' },
    { name: 'Serviços', href: '/servicos' },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(offerCatalog)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</BaseLayout>
