---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import site from '~/data/site.json';
const mapsUrl = `https://www.google.com/maps?q=${encodeURIComponent(site.location.mapsQuery)}`;
---
<BaseLayout
  title="Contato · Vicji Massage"
  description="Como entrar em contato com Victor. Atendimento em Itacaré, Bahia."
  lang="pt"
  path="/contato"
>
  <section class="py-24 sm:py-32">
    <div class="container-narrow">
      <div class="label-overline mb-4">Contato</div>
      <h1 class="font-display text-5xl sm:text-6xl text-ocean mb-12 leading-tight">
        Onde me encontrar.
      </h1>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <h2 class="font-display text-2xl text-ocean mb-4">Estúdio</h2>
          <address class="not-italic text-ink-muted leading-relaxed">
            {site.location.studio && (
              <span class="block font-semibold text-ink">{site.location.studio}</span>
            )}
            <span class="block">{site.location.street}</span>
            {site.location.neighborhood && (
              <span class="block">{site.location.neighborhood}</span>
            )}
            <span class="block">{site.location.city}, {site.location.state}</span>
            <span class="block">{site.location.postalCode}</span>
          </address>
          <a href={mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 text-ocean hover:text-terracotta transition-colors text-sm">
            Abrir no Google Maps
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
          </a>
        </div>

        <div class="bg-white/60 rounded-2xl p-8 border border-sand-deep/30">
          <h2 class="font-display text-2xl text-ocean mb-4">Direto</h2>
          <ul class="space-y-3 text-ink-muted">
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">WhatsApp</span>
              <a href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener" class="text-ink hover:text-ocean">
                {site.contact.whatsappDisplay} →
              </a>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">Instagram</span>
              <a href={site.contact.instagramUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-ink hover:text-ocean transition-colors group">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-terracotta group-hover:text-ocean">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                </svg>
                @{site.contact.instagram} · {site.contact.instagramFollowers} seguidores
              </a>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-widest2 text-terracotta mb-1">Horário</span>
              <span class="text-ink">{site.hours.pt}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 aspect-[16/9] rounded-2xl overflow-hidden border border-sand-deep/30 bg-sand-dark/30 flex items-center justify-center">
        <iframe
          src={`https://www.google.com/maps?q=${encodeURIComponent(site.location.mapsQuery)}&output=embed`}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

    </div>
  </section>
  <Breadcrumbs items={[
    { name: 'Início', href: '/' },
    { name: 'Contato', href: '/contato' },
  ]} />
</BaseLayout>
