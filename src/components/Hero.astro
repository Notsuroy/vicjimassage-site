---
import site from '~/data/site.json';

export interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const content = {
  pt: {
    eyebrow: 'Corpo · Energia · Espírito',
    headline: 'Massagem tailandesa que trabalha o corpo em três dimensões.',
    sub: 'Físico, energético e espiritual. É essa a base da Thai Massage tradicional. Aprendi na Tailândia, aprofundei na Índia, e trouxe pra Atibaia.',
    primary: 'Agendar uma sessão',
    secondary: 'Conhecer o trabalho',
    primaryHref: '/agendar',
    secondaryHref: '/sobre',
    proofPrefix: '★★★★★  ·  Mais de 200 sessões  ·  ',
    proofSuffix: ` seguidores`,
  },
  en: {
    eyebrow: 'Body · Energy · Spirit',
    headline: 'Thai Massage that works the body in three dimensions.',
    sub: 'Physical, energetic, and spiritual. That is the foundation of traditional Thai Massage. I learned it in Thailand, deepened it in India, and brought the practice home to Atibaia.',
    primary: 'Book a session',
    secondary: 'See the work',
    primaryHref: '/en/book',
    secondaryHref: '/en/about',
    proofPrefix: '★★★★★  ·  200+ sessions delivered  ·  ',
    proofSuffix: ` followers`,
  },
};

const c = content[lang];
---

<section class="relative overflow-hidden">
  <!-- Hero photo: vertical (mobile) + landscape (desktop ≥768px) -->
  <div class="absolute inset-0 z-0">
    <picture>
      <!-- Desktop: WebP first, JPEG fallback -->
      <source media="(min-width: 768px)" type="image/webp" srcset="/photos/hero.webp" />
      <source media="(min-width: 768px)" srcset="/photos/hero.jpg" />
      <!-- Mobile: WebP first, JPEG fallback -->
      <source type="image/webp" srcset="/photos/gallery-01.webp" />
      <img
        src="/photos/gallery-01.jpg"
        alt="Vicji aplicando massagem tailandesa tradicional em sessão ao ar livre"
        class="absolute inset-0 w-full h-full object-cover md:object-[50%_75%] object-center"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <!-- Mobile gradient (top→bottom, heavier at bottom for text legibility) -->
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-dark/95 via-ocean-dark/50 to-ocean-dark/30 md:hidden"></div>
    <!-- Desktop gradient (left→right, heavier on left where text lives) -->
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-dark/85 via-ocean-dark/60 to-ocean-dark/30 hidden md:block"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-dark/80 via-transparent to-transparent hidden md:block"></div>
  </div>

  <div class="relative z-10 container-wide pt-24 pb-32 sm:pt-32 sm:pb-40 lg:pt-40 lg:pb-48">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-px w-12 bg-gold"></span>
        <span class="text-gold uppercase tracking-widest2 text-xs font-medium">{c.eyebrow}</span>
      </div>

      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl text-sand leading-[1.05] mb-8">
        {c.headline}
      </h1>

      <p class="text-sand/90 text-lg sm:text-xl leading-relaxed max-w-2xl mb-10 font-light">
        {c.sub}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={c.primaryHref} class="btn-primary !bg-terracotta hover:!bg-terracotta-dark">
          {c.primary}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <a href={c.secondaryHref} class="btn-secondary !border-sand/40 !text-sand hover:!bg-sand/10 hover:!border-sand/70">
          {c.secondary}
        </a>
      </div>

      <div class="mt-12 text-sand/70 text-sm tracking-wide flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>{c.proofPrefix}</span>
        <a
          href={site.contact.instagramUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-sand hover:text-gold transition-colors group"
          aria-label={`Instagram @${site.contact.instagram}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" class="transition-transform group-hover:scale-110">
            <defs>
              <linearGradient id="ig-grad-hero" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#FED576" />
                <stop offset="25%" stop-color="#F47133" />
                <stop offset="50%" stop-color="#BC3081" />
                <stop offset="75%" stop-color="#4C63D2" />
                <stop offset="100%" stop-color="#5851DB" />
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#ig-grad-hero)" />
            <rect x="4.5" y="4.5" width="15" height="15" rx="4" fill="none" stroke="white" stroke-width="1.5" />
            <circle cx="12" cy="12" r="3.5" fill="none" stroke="white" stroke-width="1.5" />
            <circle cx="17.5" cy="6.5" r="0.9" fill="white" />
          </svg>
          @{site.contact.instagram}
        </a>
        <span>· {site.contact.instagramFollowers}{c.proofSuffix}</span>
      </div>
    </div>
  </div>
</section>
