---
import site from '~/data/site.json';

export interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const content = {
  pt: {
    eyebrow: 'Massagem tailandesa tradicional',
    headline: 'Trabalho corporal que respeita o tempo do corpo.',
    sub: 'Aprendi na Tailândia, pratico em Atibaia. Sessões para quem busca presença, alívio e uma forma mais antiga de cuidar do corpo.',
    primary: 'Agendar uma sessão',
    secondary: 'Conhecer o trabalho',
    primaryHref: '/agendar',
    secondaryHref: '/sobre',
    proofPrefix: '★★★★★  ·  Mais de 100 sessões  ·  ',
    proofSuffix: ` seguidores`,
  },
  en: {
    eyebrow: 'Traditional Thai bodywork',
    headline: 'Bodywork that respects the body\'s own pace.',
    sub: 'I learned it in Thailand, I practice it in Atibaia. Sessions for those seeking presence, relief, and a more ancient way of caring for the body.',
    primary: 'Book a session',
    secondary: 'See the work',
    primaryHref: '/en/book',
    secondaryHref: '/en/about',
    proofPrefix: '★★★★★  ·  100+ sessions delivered  ·  ',
    proofSuffix: ` followers`,
  },
};

const c = content[lang];
---

<section class="relative overflow-hidden">
  <!-- Hero photo: Vicji giving massage in park, golden hour -->
  <div class="absolute inset-0 z-0">
    <img
      src="/photos/hero.jpg"
      alt="Vicji conduzindo uma sessão de massagem tailandesa em um parque ao entardecer"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ocean-dark/85 via-ocean-dark/60 to-ocean-dark/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-dark/90 via-transparent to-ocean-dark/20"></div>
  </div>

  <div class="relative z-10 container-wide pt-24 pb-32 sm:pt-32 sm:pb-40 lg:pt-40 lg:pb-48">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-px w-12 bg-gold"></span>
        <span class="text-gold uppercase tracking-widest2 text-xs font-medium">{c.eyebrow}</span>
      </div>

      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl text-sand leading-[1.05] mb-8">
        {c.headline}
      </h1>

      <p class="text-sand/90 text-lg sm:text-xl leading-relaxed max-w-2xl mb-10 font-light">
        {c.sub}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href={c.primaryHref} class="btn-primary !bg-terracotta hover:!bg-terracotta-dark">
          {c.primary}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <a href={c.secondaryHref} class="btn-secondary !border-sand/40 !text-sand hover:!bg-sand/10 hover:!border-sand/70">
          {c.secondary}
        </a>
      </div>

      <div class="mt-12 text-sand/70 text-sm tracking-wide flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>{c.proofPrefix}</span>
        <a
          href={site.contact.instagramUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-sand hover:text-gold transition-colors group"
          aria-label={`Instagram @${site.contact.instagram}`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-80 group-hover:opacity-100">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
          </svg>
          @{site.contact.instagram}
        </a>
        <span>· {site.contact.instagramFollowers}{c.proofSuffix}</span>
      </div>
    </div>
  </div>
</section>
