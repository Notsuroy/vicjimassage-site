---
import reviews from '~/data/reviews.json';

export interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;

const content = {
  pt: {
    overline: `${reviews.aggregate.count}+ sessões realizadas`,
    headline: 'O corpo lembra. Eles também.',
    sub: 'Mensagens reais que recebi após as sessões. Toca em qualquer print para ver inteiro.',
    filterLabel: 'Filtrar por:',
    close: 'Fechar',
    featured: 'Destaque',
    translatedLabel: 'Tradução abaixo',
    via: 'via',
    none: 'Nenhuma avaliação neste tema ainda.',
    seeMore: 'Toca para ver',
  },
  en: {
    overline: `${reviews.aggregate.count}+ sessions delivered`,
    headline: 'The body remembers. So do they.',
    sub: "Real messages I've received after sessions. Tap any screenshot to read the full message.",
    filterLabel: 'Filter by:',
    close: 'Close',
    featured: 'Featured',
    translatedLabel: 'Translation below',
    via: 'via',
    none: 'No reviews under this theme yet.',
    seeMore: 'Tap to view',
  },
};

const c = content[lang];
const themes = reviews.themes[lang];

// Sort featured first, then others in order
const sorted = [...reviews.reviews].sort((a, b) => {
  if (a.featured === b.featured) return 0;
  return a.featured ? -1 : 1;
});

function getTranslation(review: any, currentLang: 'pt' | 'en') {
  if (!review.original) return null;
  if (review.lang === currentLang) return null; // already in current language
  return review.translated?.[currentLang] ?? null;
}
---

<section class="py-24 sm:py-32 bg-gradient-to-b from-sand to-sand-dark/40">
  <div class="container-wide">
    <div class="max-w-narrow mx-auto text-center mb-12">
      <div class="label-overline mb-4">{c.overline}</div>
      <h2 class="font-display text-4xl sm:text-5xl text-ink mb-6">{c.headline}</h2>
      <p class="text-ink-muted text-lg leading-relaxed">{c.sub}</p>
    </div>

    <!-- Filter chips -->
    <div class="flex flex-wrap justify-center gap-2 mb-12">
      <span class="text-sm text-ink-muted self-center mr-2">{c.filterLabel}</span>
      {themes.map((theme, i) => (
        <button
          data-theme={theme.id}
          class={`review-filter px-4 py-2 rounded-full text-sm transition-all duration-300 ${
            i === 0
              ? 'bg-ocean text-sand border border-ocean'
              : 'bg-white/60 text-ink-muted border border-sand-deep/40 hover:bg-white hover:text-ocean'
          }`}
        >
          {theme.label}
        </button>
      ))}
    </div>

    <!-- Masonry-style screenshot grid -->
    <div id="reviews-grid" class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 max-w-7xl mx-auto">
      {sorted.map((review) => {
        const translation = getTranslation(review, lang);
        const themeAttr = (review.themes || []).join(',');
        return (
          <article
            data-themes={themeAttr}
            data-review-id={review.id}
            data-translation={translation ?? ''}
            data-original={review.original ?? ''}
            data-author={review.author ?? ''}
            data-meta={`${review.city ? review.city + ' · ' : ''}${review.date ?? ''} · via ${review.source ?? 'WhatsApp'}`}
            class="review-screenshot break-inside-avoid mb-4 relative group cursor-pointer rounded-2xl overflow-hidden shadow-card bg-white hover:shadow-soft transition-all duration-500 hover:-translate-y-1"
          >
            <picture>
              <source type="image/webp" srcset={review.image.replace(/\.jpe?g$/i, '.webp')} />
              <img
                src={review.image}
                alt={`Avaliação ${review.id}`}
                loading="lazy"
                decoding="async"
                class="w-full h-auto block"
              />
            </picture>
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-ocean-dark/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <div class="text-sand text-xs uppercase tracking-widest2 flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M11 8v6M8 11h6"/></svg>
                {c.seeMore}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div id="reviews-empty" class="hidden text-center text-ink-muted mt-12 italic">{c.none}</div>
  </div>

  <!-- Hidden SEO-only text containing transcribed reviews. Search engines index them; visitors don't see them. -->
  <div class="sr-only" aria-hidden="true">
    {reviews.reviews.filter(r => r.featured).map(r => (
      <div>
        <p>{r.author} ({r.city}, {r.date}): "{r.original}"</p>
        {r.translated?.en && <p>English translation: "{r.translated.en}"</p>}
      </div>
    ))}
  </div>
</section>

<!-- Full-screenshot modal -->
<div id="review-modal" class="fixed inset-0 z-[60] bg-ocean-dark/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8">
  <div class="bg-sand rounded-2xl max-w-5xl w-full max-h-[92vh] overflow-hidden relative shadow-2xl flex flex-col md:flex-row">
    <button id="review-modal-close" aria-label={c.close} class="absolute top-3 right-3 z-20 w-10 h-10 rounded-full bg-ocean/80 hover:bg-ocean text-sand flex items-center justify-center transition-colors backdrop-blur-sm">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <!-- Image side -->
    <div class="md:w-1/2 bg-ocean-dark flex items-center justify-center overflow-y-auto">
      <img id="review-modal-image" src="" alt="" class="w-full h-auto object-contain max-h-[60vh] md:max-h-[92vh]" />
    </div>
    <!-- Text side -->
    <div class="md:w-1/2 p-6 sm:p-10 overflow-y-auto">
      <div class="flex items-center gap-1 text-gold mb-4">
        {[1,2,3,4,5].map(() => (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        ))}
      </div>
      <p id="review-modal-translation" class="text-ink-muted text-base leading-relaxed mb-4 italic"></p>
      <p id="review-modal-original" class="text-ink text-base leading-relaxed whitespace-pre-line"></p>
      <div id="review-modal-meta" class="mt-6 pt-4 border-t border-sand-deep/40 text-sm text-ink-muted"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const filters = document.querySelectorAll('.review-filter');
    const cards = document.querySelectorAll('#reviews-grid .review-screenshot');
    const empty = document.getElementById('reviews-empty');
    const modal = document.getElementById('review-modal');
    const modalImg = document.getElementById('review-modal-image');
    const modalOriginal = document.getElementById('review-modal-original');
    const modalTranslation = document.getElementById('review-modal-translation');
    const modalMeta = document.getElementById('review-modal-meta');
    const modalClose = document.getElementById('review-modal-close');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme');
        filters.forEach(f => {
          f.classList.remove('bg-ocean', 'text-sand', 'border-ocean');
          f.classList.add('bg-white/60', 'text-ink-muted', 'border-sand-deep/40');
        });
        btn.classList.add('bg-ocean', 'text-sand', 'border-ocean');
        btn.classList.remove('bg-white/60', 'text-ink-muted', 'border-sand-deep/40');
        let visible = 0;
        cards.forEach(card => {
          const themes = (card.getAttribute('data-themes') || '').split(',');
          const show = theme === 'all' || themes.includes(theme);
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      });
    });

    function openModal(card) {
      const img = card.querySelector('img');
      const original = card.getAttribute('data-original') || '';
      const translation = card.getAttribute('data-translation') || '';
      const author = card.getAttribute('data-author') || '';
      const meta = card.getAttribute('data-meta') || '';
      if (modalImg && img) { modalImg.src = img.src; modalImg.alt = img.alt; }
      if (modalOriginal) { modalOriginal.textContent = original; modalOriginal.style.display = original ? '' : 'none'; }
      if (modalTranslation) { modalTranslation.textContent = translation; modalTranslation.style.display = translation ? '' : 'none'; }
      if (modalMeta) { modalMeta.textContent = author ? (author + ' · ' + meta) : meta; }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
    cards.forEach(card => card.addEventListener('click', () => openModal(card)));
    modalClose && modalClose.addEventListener('click', closeModal);
    modal && modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  })();
</script>
