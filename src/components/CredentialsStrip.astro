---
export interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;

const content = {
  pt: {
    items: [
      { icon: '🪷', label: 'Tailândia', sub: 'Formação na fonte' },
      { icon: '🕉️', label: 'Índia', sub: 'Yoga e prática energética' },
      { icon: '✋', label: '2500+ sessões', sub: 'Realizadas ao longo dos anos' },
      { icon: '🌎', label: 'Único no Brasil', sub: 'Atendimento integrado' },
    ],
  },
  en: {
    items: [
      { icon: '🪷', label: 'Thailand', sub: 'Trained at the source' },
      { icon: '🕉️', label: 'India', sub: 'Yoga and energetic practice' },
      { icon: '✋', label: '2500+ sessions', sub: 'Given over the years' },
      { icon: '🌎', label: 'Only one in Brazil', sub: 'Offering integrated work' },
    ],
  },
};

const c = content[lang];
---

<section class="pb-12 sm:pb-16">
  <div class="container-narrow">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-6">
      {c.items.map(item => (
        <div class="bg-white/60 border border-sand-deep/30 rounded-2xl p-4 sm:p-5 text-center">
          <div class="text-3xl mb-2">{item.icon}</div>
          <div class="font-display text-base sm:text-lg text-ocean leading-tight">{item.label}</div>
          <div class="text-xs text-ink-muted mt-1 leading-snug">{item.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>
