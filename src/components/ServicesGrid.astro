---
import services from '~/data/services.json';
import site from '~/data/site.json';

export interface Props {
  lang: 'pt' | 'en';
  showAll?: boolean;
}
const { lang, showAll = false } = Astro.props;

const content = {
  pt: {
    overline: 'O que ofereço',
    headline: 'Sessões exclusivas e originais.',
    sub: 'A sessão completa, que percorre o corpo todo, e a sessão focada no quadril, centro energético e biomecânico do corpo. Ambas trabalham o campo físico, energético e espiritual.',
    recommended: 'Sessão completa',
    book: 'Agendar',
    seeAll: 'Ver detalhes das sessões',
    seeAllHref: '/servicos',
    each: 'cada',
    included: 'O que está incluso na sessão',
    highlightsLabel: 'A sessão inclui',
  },
  en: {
    overline: 'What I offer',
    headline: 'Exclusive, original sessions.',
    sub: 'The full session, head to toe, and the focused hip-release session for the body\'s energetic and biomechanical center. Both work the physical, energetic, and spiritual field.',
    recommended: 'Full session',
    book: 'Book',
    seeAll: 'See session details',
    seeAllHref: '/en/services',
    each: 'each',
    included: "What's included in the session",
    highlightsLabel: 'The session includes',
  },
};

const c = content[lang];
const items = services.services;
const bookHref = lang === 'pt' ? '/agendar' : '/en/book';

// FX helpers, only used when lang === 'en'
const usdRate = site.fx?.usdPerBrl ?? 0.196;
const eurRate = site.fx?.eurPerBrl ?? 0.181;
function fxLine(brl: number) {
  const usd = Math.round(brl * usdRate);
  const eur = Math.round(brl * eurRate);
  return `≈ USD $${usd} / EUR €${eur}`;
}
---

<section class="py-24 sm:py-32">
  <div class="container-wide">
    <div class="max-w-narrow mx-auto text-center mb-16">
      <div class="label-overline mb-4">{c.overline}</div>
      <h2 class="font-display text-4xl sm:text-5xl text-ink mb-6 leading-tight">
        {c.headline.split('. ').map((part, i, arr) => (
          <span class="block">{part}{i < arr.length - 1 ? '.' : ''}</span>
        ))}
      </h2>
      <p class="text-ink-muted text-lg leading-relaxed">{c.sub}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {items.map(svc => (
        <div class={`relative rounded-2xl p-8 sm:p-10 flex flex-col transition-all duration-500 ${
          svc.highlight
            ? 'bg-ocean text-sand shadow-soft ring-2 ring-gold'
            : 'bg-white/60 backdrop-blur-sm border border-sand-deep/30 hover:shadow-soft'
        }`}>
          {svc.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold text-ocean-dark text-xs uppercase tracking-widest2 px-4 py-1 rounded-full font-medium whitespace-nowrap">
              {c.recommended}
            </div>
          )}

          <h3 class={`font-display text-3xl mb-2 ${svc.highlight ? 'text-sand' : 'text-ocean'}`}>
            {svc.name[lang]}
          </h3>
          <p class={`font-display italic text-lg mb-6 ${svc.highlight ? 'text-gold' : 'text-terracotta'}`}>
            {svc.tagline[lang]}
          </p>

          <p class={`text-base leading-relaxed mb-6 flex-1 ${svc.highlight ? 'text-sand/85' : 'text-ink-muted'}`}>
            {svc.description[lang]}
          </p>

          {showAll && svc.highlights && (
            <ul class={`space-y-2 mb-6 text-sm ${svc.highlight ? 'text-sand/90' : 'text-ink-muted'}`}>
              {svc.highlights[lang].map(h => (
                <li class="flex items-start gap-2">
                  <span class={svc.highlight ? 'text-gold mt-0.5' : 'text-terracotta mt-0.5'}>·</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}

          {showAll && svc.included && (
            <div class={`rounded-xl p-5 mb-6 ${svc.highlight ? 'bg-sand/10 border border-sand/20' : 'bg-sand-dark/40 border border-sand-deep/40'}`}>
              <div class={`text-xs uppercase tracking-widest2 mb-3 ${svc.highlight ? 'text-gold' : 'text-terracotta'}`}>
                {c.included}
              </div>
              <ul class={`space-y-2 text-sm ${svc.highlight ? 'text-sand/90' : 'text-ink-muted'}`}>
                {svc.included[lang].map(item => (
                  <li class="flex items-start gap-2">
                    <span class={svc.highlight ? 'text-gold mt-0.5' : 'text-terracotta mt-0.5'}>✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Pricing options -->
          <div class={`pt-6 border-t ${svc.highlight ? 'border-sand/20' : 'border-sand-deep/40'}`}>
            <div class={`text-xs uppercase tracking-widest2 mb-3 ${svc.highlight ? 'text-gold' : 'text-terracotta'}`}>
              {svc.options.length > 1 ? (lang === 'pt' ? 'Duração' : 'Duration') : (lang === 'pt' ? 'Sessão' : 'Session')}
            </div>
            <div class="space-y-3 mb-6">
              {svc.options.map(opt => (
                <div>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class={svc.highlight ? 'text-sand' : 'text-ink'}>
                      {opt.label[lang]}
                    </span>
                    {lang === 'en' ? (
                      <span class={`font-display text-xl sm:text-2xl whitespace-nowrap ${svc.highlight ? 'text-gold' : 'text-ocean'}`}>
                        {fxLine(opt.price)}
                      </span>
                    ) : (
                      <span class={`font-display text-2xl ${svc.highlight ? 'text-gold' : 'text-ocean'}`}>
                        {opt.priceDisplay}
                      </span>
                    )}
                  </div>
                  {lang === 'en' && (
                    <div class={`text-xs text-right mt-0.5 ${svc.highlight ? 'text-sand/60' : 'text-ink-muted/70'}`}>
                      {opt.priceDisplay}
                    </div>
                  )}
                </div>
              ))}
            </div>

            <a
              href={bookHref}
              class={svc.highlight
                ? 'inline-flex items-center justify-center w-full py-3 rounded-full bg-terracotta text-sand font-medium hover:bg-terracotta-dark transition-colors'
                : 'inline-flex items-center justify-center w-full py-3 rounded-full bg-ocean text-sand font-medium hover:bg-ocean-dark transition-colors'}
            >
              {c.book}
            </a>
          </div>
        </div>
      ))}
    </div>

    {!showAll && (
      <div class="text-center mt-12">
        <a href={c.seeAllHref} class="text-ocean hover:text-terracotta transition-colors font-medium underline underline-offset-4 decoration-gold/50">
          {c.seeAll} →
        </a>
      </div>
    )}
  </div>
</section>
