---
import faq from '~/data/faq.json';

export interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const items = faq[lang];

const headlines = {
  pt: { overline: 'Dúvidas frequentes', headline: 'O que você pode estar se perguntando.' },
  en: { overline: 'Frequently asked', headline: 'What you might be wondering.' },
};
const h = headlines[lang];
---

<section class="py-24 sm:py-32">
  <div class="container-narrow">
    <div class="text-center mb-16">
      <div class="label-overline mb-4">{h.overline}</div>
      <h2 class="font-display text-4xl sm:text-5xl text-ink">{h.headline}</h2>
    </div>

    <div class="space-y-3">
      {items.map((item, i) => (
        <details class="group bg-white/60 backdrop-blur-sm rounded-2xl border border-sand-deep/30 overflow-hidden">
          <summary class="cursor-pointer p-6 flex items-center justify-between gap-4 list-none">
            <span class="font-display text-xl text-ocean pr-4">{item.q}</span>
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-sand-dark/40 flex items-center justify-center text-ocean group-open:rotate-45 transition-transform duration-300">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-ink-muted leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
